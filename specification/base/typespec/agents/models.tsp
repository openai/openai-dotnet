import "@typespec/openapi";
import "@azure-tools/typespec-client-generator-core";

import "./models_tools.tsp";

using Azure.ClientGenerator.Core;
using Http;
using TypeSpec.OpenAPI;

namespace OpenAI;

// --------- Reasoning ---------

/** The amount of reasoning effort the model should use. */
union ReasoningEffortParam {
  none: "none",
  minimal: "minimal",
  low: "low",
  medium: "medium",
  high: "high",
  xhigh: "xhigh",
  max: "max",
}

/** The reasoning summary format requested from the model. */
union ReasoningSummaryParam {
  /** Returns a concise reasoning summary when supported. */
  concise: "concise",

  /** Returns a detailed reasoning summary when supported. */
  detailed: "detailed",

  /** Automatically selects the most detailed summary supported by the model. */
  auto: "auto",
}

/** Reasoning configuration for the agent. */
model ReasoningParam {
  /** The amount of reasoning effort the model should use. Omission lets the model select it. */
  effort?: ReasoningEffortParam | null;

  /** Controls whether the response includes a reasoning summary. */
  summary?: ReasoningSummaryParam | null;
}

/** The amount of reasoning effort used by an agent. */
union ReasoningEffortResource {
  none: "none",
  minimal: "minimal",
  low: "low",
  medium: "medium",
  high: "high",
  xhigh: "xhigh",
  max: "max",
}

/** The reasoning summary format requested from an agent. */
union ReasoningSummaryResource {
  concise: "concise",
  detailed: "detailed",
  auto: "auto",
}

/** The reasoning configuration used by an agent. */
model ReasoningResource {
  /** The requested reasoning effort, or `null` when the model selects its own default. */
  effort: ReasoningEffortResource | null;

  /** The requested reasoning summary format, or `null` when summaries are disabled. */
  summary: ReasoningSummaryResource | null;
}

// --------- Text ---------

/** The output format for generated text. */
union TextFormatType {
  string,
  text: "text",
  json_schema: "json_schema",
}

@discriminator("type")
model TextFormatParam {
  type: TextFormatType;
}

/** Generates ordinary text without a structured-output constraint. */
model TextFormatParamText extends TextFormatParam {
  /** The type of the object. Always `text`. */
  type: TextFormatType.text;
}

/** Constrains generated text to a JSON Schema. */
model TextFormatParamJsonSchema extends TextFormatParam {
  /** The type of the object. Always `json_schema`. */
  type: TextFormatType.json_schema;

  /** The JSON Schema that generated text must match. */
  schema: Record<unknown>;
}

/** The amount of text the model should produce. */
union VerbosityParam {
  /** Produces less text. */
  low: "low",

  /** Uses the default amount of text. */
  medium: "medium",

  /** Produces more text. */
  high: "high",
}

/** Configuration for text generated by the agent. */
model TextParam {
  /** The output format. Omission uses ordinary text (`{"type": "text"}`). */
  format?: TextFormatParam | null;

  /** The amount of text the model should produce. Defaults to `medium`, matching Responses. */
  verbosity?: VerbosityParam | null;
}

@discriminator("type")
model TextFormatResource {
  type: TextFormatType;
}

/** Generates ordinary text without a structured-output constraint. */
model TextFormatResourceText extends TextFormatResource {
  /** The type of the object. Always `text`. */
  type: TextFormatType.text;
}

/** Constrains generated text to a JSON Schema. */
model TextFormatResourceJsonSchema extends TextFormatResource {
  /** The type of the object. Always `json_schema`. */
  type: TextFormatType.json_schema;

  /** The JSON Schema that generated text must match. */
  schema: Record<unknown>;
}

/** The amount of text produced by an agent. */
union VerbosityResource {
  low: "low",
  medium: "medium",
  high: "high",
}

/** The text configuration used by an agent. */
model TextResource {
  /** The effective output format. Defaults to ordinary text. */
  format: TextFormatResource;

  /** The amount of text produced by the agent. Defaults to `medium`. */
  verbosity: VerbosityResource;
}

// --------- Service tier ---------

/** The service tier used for model requests. */
union ServiceTierParam {
  /** Selects the service tier automatically. */
  auto: "auto",

  /** Uses the default service tier. */
  default: "default",

  /** Uses the flex service tier. */
  flex: "flex",

  /** Uses the priority service tier. */
  priority: "priority",

  /** Uses the fast service tier. */
  fast: "fast",
}

/** The service-tier policy configured for an agent. */
union ServiceTierResource {
  auto: "auto",
  default: "default",
  flex: "flex",
  priority: "priority",
  fast: "fast",
}

// --------- Multi-agent ---------

/** Explicit configuration for creating and coordinating subagents. */
model MultiAgentConfigCurrentParam {
  /** Whether subagent tools are enabled. */
  enabled: boolean;

  /** Maximum number of subagents that may run concurrently. Defaults to 6. */
  @minValue(1)
  @maxValue(4294967295)
  max_concurrent_subagents?: int64;
}

/** The resolved configuration for creating and coordinating subagents. */
model MultiAgentConfigResource {
  /** Whether subagent tools are enabled. Defaults to false. */
  enabled: boolean;

  /** Maximum number of subagents that may run concurrently, or null when disabled. Defaults to 6 when enabled. */
  @minValue(1)
  @maxValue(4294967295)
  max_concurrent_subagents: int64 | null;
}

// --------- Create agent ---------

/** Parameters for creating a reusable agent. */
model CreateAgentParams {
  /**
   * Up to 16 string key-value pairs, with keys up to 64 and values up to 512 characters.
   * Omission or null defaults to an empty map.
   */
  metadata?: Record<string> | null;

  /** A human-readable name for the agent. Omission or null leaves the agent unnamed. */
  @maxLength(128)
  name?: string | null;

  /** The model to use for the agent. The requested model name is preserved. */
  `model`: string;

  /** Configuration for model reasoning. Omission uses the model's default effort. */
  reasoning?: ReasoningParam | null;

  /** Configuration for generated text. Defaults to the `text` format and medium verbosity. */
  text?: TextParam | null;

  /** The service tier used for model requests. Defaults to `auto`. */
  service_tier?: ServiceTierParam | null;

  /**
   * Additional instructions appended to the agent's default base instructions.
   * Omit or set to null to add no custom instructions.
   */
  instructions?: string | null;

  /** Tools available to the agent. Defaults to an empty list. */
  @maxItems(2000)
  tools?: PersistedAgentToolConfigParam[] | null;

  /**
   * Configuration for creating and coordinating subagents. Subagent tools are disabled by default.
   */
  multi_agent?: MultiAgentConfigCurrentParam | null;
}

/** The object type. Always `agent`. */
union AgentObject {
  string,
  agent: "agent",
}

/** A reusable agent scoped to the caller's project. */
model AgentResource {
  /** The ID of the reusable agent. */
  id: string;

  /** The object type. Always `agent`. */
  object: AgentObject;

  /** The Unix timestamp, in seconds, when the agent was created. */
  created_at: int64;

  /** The Unix timestamp, in seconds, when the agent was last updated. */
  updated_at: int64;

  /** A human-readable name for the agent, or null if it is unnamed. */
  name: string | null;

  /** Custom string key-value pairs attached to the agent. */
  metadata: Record<string>;

  /** The requested model name used for inference. */
  `model`: string;

  /** The resolved reasoning configuration, including the model default for an omitted effort. */
  reasoning: ReasoningResource;

  /** The resolved configuration for text generated by the agent. */
  text: TextResource;

  /** The resolved service-tier policy used for model requests. */
  service_tier: ServiceTierResource;

  /** Custom instructions appended to the agent's default base instructions. */
  instructions: string | null;

  /** Tools available to the agent. */
  @maxItems(2000)
  tools: PersistedAgentToolResource[];

  /** The resolved configuration for creating and coordinating subagents. */
  multi_agent: MultiAgentConfigResource;
}
