import "@typespec/openapi";
import "@azure-tools/typespec-client-generator-core";

import "./models_tools.tsp";

using Azure.ClientGenerator.Core;
using Http;
using TypeSpec.OpenAPI;

namespace OpenAI;

// ------------ Reasoning ------------

/** The amount of reasoning effort the model should use. */
union ReasoningEffortParam {
  none: "none",
  minimal: "minimal",
  low: "low",
  medium: "medium",
  high: "high",
  xhigh: "xhigh",
  max: "max",
}

/** The reasoning summary format requested from the model. */
union ReasoningSummaryParam {
  /** Returns a concise reasoning summary when supported. */
  concise: "concise",

  /** Returns a detailed reasoning summary when supported. */
  detailed: "detailed",

  /** Automatically selects the most detailed summary supported by the model. */
  auto: "auto",
}

/** Reasoning configuration for the agent. */
model ReasoningParam {
  /** The amount of reasoning effort the model should use. Omission lets the model select it. */
  effort?: ReasoningEffortParam | null;

  /** Controls whether the response includes a reasoning summary. */
  summary?: ReasoningSummaryParam | null;
}

/** The amount of reasoning effort used by an agent. */
union ReasoningEffortResource {
  none: "none",
  minimal: "minimal",
  low: "low",
  medium: "medium",
  high: "high",
  xhigh: "xhigh",
  max: "max",
}

/** The reasoning summary format requested from an agent. */
union ReasoningSummaryResource {
  concise: "concise",
  detailed: "detailed",
  auto: "auto",
}

/** The reasoning configuration used by an agent. */
model ReasoningResource {
  /** The requested reasoning effort, or `null` when the model selects its own default. */
  effort: ReasoningEffortResource | null;

  /** The requested reasoning summary format, or `null` when summaries are disabled. */
  summary: ReasoningSummaryResource | null;
}

// ------------ Text ------------

/** The output format for generated text. */
union TextFormatType {
  string,
  text: "text",
  json_schema: "json_schema",
}

@discriminator("type")
model TextFormatParam {
  type: TextFormatType;
}

/** Generates ordinary text without a structured-output constraint. */
model TextFormatParamText extends TextFormatParam {
  /** The type of the object. Always `text`. */
  type: TextFormatType.text;
}

/** Constrains generated text to a JSON Schema. */
model TextFormatParamJsonSchema extends TextFormatParam {
  /** The type of the object. Always `json_schema`. */
  type: TextFormatType.json_schema;

  /** The JSON Schema that generated text must match. */
  schema: Record<unknown>;
}

/** The amount of text the model should produce. */
union VerbosityParam {
  /** Produces less text. */
  low: "low",

  /** Uses the default amount of text. */
  medium: "medium",

  /** Produces more text. */
  high: "high",
}

/** Configuration for text generated by the agent. */
model TextParam {
  /** The output format. Omission uses ordinary text (`{"type": "text"}`). */
  format?: TextFormatParam | null;

  /** The amount of text the model should produce. Defaults to `medium`, matching Responses. */
  verbosity?: VerbosityParam | null;
}

@discriminator("type")
model TextFormatResource {
  type: TextFormatType;
}

/** Generates ordinary text without a structured-output constraint. */
model TextFormatResourceText extends TextFormatResource {
  /** The type of the object. Always `text`. */
  type: TextFormatType.text;
}

/** Constrains generated text to a JSON Schema. */
model TextFormatResourceJsonSchema extends TextFormatResource {
  /** The type of the object. Always `json_schema`. */
  type: TextFormatType.json_schema;

  /** The JSON Schema that generated text must match. */
  schema: Record<unknown>;
}

/** The amount of text produced by an agent. */
union VerbosityResource {
  low: "low",
  medium: "medium",
  high: "high",
}

/** The text configuration used by an agent. */
model TextResource {
  /** The effective output format. Defaults to ordinary text. */
  format: TextFormatResource;

  /** The amount of text produced by the agent. Defaults to `medium`. */
  verbosity: VerbosityResource;
}

// ------------ Service tier ------------

/** The service tier used for model requests. */
union ServiceTierParam {
  /** Selects the service tier automatically. */
  auto: "auto",

  /** Uses the default service tier. */
  default: "default",

  /** Uses the flex service tier. */
  flex: "flex",

  /** Uses the priority service tier. */
  priority: "priority",

  /** Uses the fast service tier. */
  fast: "fast",
}

/** The service-tier policy configured for an agent. */
union ServiceTierResource {
  auto: "auto",
  default: "default",
  flex: "flex",
  priority: "priority",
  fast: "fast",
}

// ------------ Multi-agent ------------

/** Explicit configuration for creating and coordinating subagents. */
model MultiAgentConfigCurrentParam {
  /** Whether subagent tools are enabled. */
  enabled: boolean;

  /** Maximum number of subagents that may run concurrently. Defaults to 6. */
  @minValue(1)
  @maxValue(4294967295)
  max_concurrent_subagents?: int64;
}

/** The resolved configuration for creating and coordinating subagents. */
model MultiAgentConfigResource {
  /** Whether subagent tools are enabled. Defaults to false. */
  enabled: boolean;

  /** Maximum number of subagents that may run concurrently, or null when disabled. Defaults to 6 when enabled. */
  @minValue(1)
  @maxValue(4294967295)
  max_concurrent_subagents: int64 | null;
}

// ------------ Create agent ------------

/** Parameters for creating a reusable agent. */
model CreateAgentParams {
  /**
   * Up to 16 string key-value pairs, with keys up to 64 and values up to 512 characters.
   * Omission or null defaults to an empty map.
   */
  @extension("x-oaiTypeLabel", "map")
  metadata?: Record<string> | null;

  /** A human-readable name for the agent. Omission or null leaves the agent unnamed. */
  @maxLength(128)
  name?: string | null;

  /** The model to use for the agent. The requested model name is preserved. */
  @maxLength(1048576)
  `model`: string;

  /** Configuration for model reasoning. Omission uses the model's default effort. */
  reasoning?: ReasoningParam | null;

  /** Configuration for generated text. Defaults to the `text` format and medium verbosity. */
  text?: TextParam | null;

  /** The service tier used for model requests. Defaults to `auto`. */
  service_tier?: ServiceTierParam | null;

  /**
   * Additional instructions appended to the agent's default base instructions.
   * Omit or set to null to add no custom instructions.
   */
   @maxLength(1048576)
  instructions?: string | null;

  /** Tools available to the agent. Defaults to an empty list. */
  @maxItems(2000)
  tools?: PersistedAgentToolConfigParam[] | null;

  /**
   * Configuration for creating and coordinating subagents. Subagent tools are disabled by default.
   */
  multi_agent?: MultiAgentConfigCurrentParam | null;
}

// ------------ Update agent ------------

/** Fields to replace on an existing reusable agent. */
model UpdateAgentParams {
  /** The model to use for the agent. The requested model name is preserved. */
  `model`?: string;

  /**
   * Configuration for model reasoning. Omit to keep the current settings; pass `null` to reset
   * to the model's default effort.
   */
  reasoning?: ReasoningParam | null;

  /** Configuration for text generated by the agent. */
  text?: TextParam | null;

  /** The service tier used for model requests. */
  service_tier?: ServiceTierParam | null;

  /** Additional instructions appended to the agent's default base instructions. Omit to leave unchanged. */
  instructions?: string | null;

  /** Configuration for creating and coordinating subagents. */
  multi_agent?: MultiAgentConfigCurrentParam | null;

  /**
   * Replaces all metadata. Omit to leave unchanged, or pass null or `{}` to clear it. Up to 16
   * string key-value pairs, with keys up to 64 and values up to 512 characters.
   */
  metadata?: Record<string> | null;

  /** A replacement name. Omit to leave unchanged, or pass null to clear it. */
  @maxLength(128)
  name?: string | null;

  /** Tools available to the agent. */
  @maxItems(2000)
  tools?: PersistedAgentToolConfigParam[] | null;
}

/** The object type. Always `agent`. */
union AgentObject {
  string,
  agent: "agent",
}

/** A reusable agent scoped to the caller's project. */
model AgentResource {
  /** The ID of the reusable agent. */
  id: string;

  /** The object type. Always `agent`. */
  object: AgentObject;

  /** The Unix timestamp, in seconds, when the agent was created. */
  created_at: int64;

  /** The Unix timestamp, in seconds, when the agent was last updated. */
  updated_at: int64;

  /** A human-readable name for the agent, or null if it is unnamed. */
  name: string | null;

  /** Custom string key-value pairs attached to the agent. */
  metadata: Record<string>;

  /** The requested model name used for inference. */
  `model`: string;

  /** The resolved reasoning configuration, including the model default for an omitted effort. */
  reasoning: ReasoningResource;

  /** The resolved configuration for text generated by the agent. */
  text: TextResource;

  /** The resolved service-tier policy used for model requests. */
  service_tier: ServiceTierResource;

  /** Custom instructions appended to the agent's default base instructions. */
  instructions: string | null;

  /** Tools available to the agent. */
  @maxItems(2000)
  tools: PersistedAgentToolResource[];

  /** The resolved configuration for creating and coordinating subagents. */
  multi_agent: MultiAgentConfigResource;
}

// ------------ Delete agent ------------

/** The object type. Always `agent.deleted`. */
union AgentDeletedObject {
  string,
  agent_deleted: "agent.deleted",
}

/** A deleted reusable agent. */
model DeletedAgentResource {
  /** The ID of the deleted agent. */
  id: string;

  /** The object type. Always `agent.deleted`. */
  object: AgentDeletedObject;

  /** Whether the agent was deleted. Always `true`. */
  deleted: boolean;
}

// ------------ List agents ------------

/** The order in which paginated agents are returned. */
union AgentCollectionOrder {
  string,

  /** Returns agents in ascending order. */
  asc: "asc",

  /** Returns agents in descending order. */
  desc: "desc",
}

@access(Access.public)
@usage(Usage.input)
model AgentCollectionOptions {
  /** The maximum number of agents to return. */
  @query
  limit?: integer;

  /** The order in which agents are returned. Defaults to `desc`. */
  @query
  order?: AgentCollectionOrder = AgentCollectionOrder.desc;

  /** Return agents after this agent ID in the selected order. */
  @query
  @continuationToken
  after?: string;
}

/** A page of reusable agents. */
model AgentCollection {
  /** The object type, which is always `list`. */
  object: "list";

  /** The agents returned in this page, in the requested sort order. */
  @pageItems
  data: AgentResource[];

  /** The ID of the first agent in `data`, or `null` if the page is empty. */
  first_id: string | null;

  /** The ID of the last agent in `data`, or `null` if the page is empty. Pass this as `after` with the same order to fetch the next page. */
  @continuationToken
  last_id: string | null;

  /** Whether there are more agents to retrieve after this page. */
  has_more: boolean;
}

// ------------ Token usage ------------

/** A breakdown of input token usage for a session or turn. */
model InputTokensDetailsResource {
  /** The number of input tokens retrieved from the prompt cache. */
  cached_tokens: int64;
}

/** A breakdown of output token usage for a session or turn. */
model OutputTokensDetailsResource {
  /** The number of output tokens used for reasoning. */
  reasoning_tokens: int64;
}

/** Recorded token usage for a session or turn. Usage is best effort and may change. */
model TokenUsageResource {
  /** The number of input tokens used by the agent. */
  input_tokens: int64;

  /** A breakdown of the agent's input token usage. */
  input_tokens_details: InputTokensDetailsResource;

  /** The number of output tokens generated by the agent. */
  output_tokens: int64;

  /** A breakdown of the agent's output token usage. */
  output_tokens_details: OutputTokensDetailsResource;

  /** The total number of input and output tokens used by the agent. */
  total_tokens: int64;
}

// ------------ Agent sessions ------------

/** The object type. Always `agent.session`. */
union SessionObject {
  string,
  agent_session: "agent.session",
}

/** The current status of a session. */
union SessionStatusResource {
  /** The session has no turn in progress and is ready for input. */
  idle: "idle",

  /** The session is processing a turn. */
  in_progress: "in_progress",

  /** The session is waiting for one or more required actions. */
  requires_action: "requires_action",

  /** The session failed. */
  failed: "failed",
}

/** The type of a session required action. */
union SessionRequiredActionType {
  string,
  function_call: "function_call",
  environment_connection: "environment_connection",
}

@discriminator("type")
model SessionRequiredActionResource {
  type: SessionRequiredActionType;
}

/** Run a function tool and submit its result. */
model SessionRequiredActionResourceFunctionCall
  extends SessionRequiredActionResource {
  /** The type of the object. Always `function_call`. */
  type: SessionRequiredActionType.function_call;

  /** The ID of the turn that requested the function call. */
  turn_id: string;

  /** The ID to include when submitting the function result. */
  call_id: string;

  /** The function name. */
  name: string;

  /** The arguments supplied by the model. */
  arguments: unknown;
}

/** Reconnect a session environment. */
model SessionRequiredActionResourceEnvironmentConnection
  extends SessionRequiredActionResource {
  /** The type of the object. Always `environment_connection`. */
  type: SessionRequiredActionType.environment_connection;

  /** The ID of the environment to reconnect. */
  environment_id: string;
}

/** The effective agent configuration for a session. */
model SessionAgentResource {
  /** The ID of the agent. */
  id: string;

  /** The reusable agent's name when the session was created, or null if no name was saved. */
  name: string | null;

  /** The model used by the agent. */
  `model`: string;

  /** The agent's reasoning configuration. */
  reasoning: ReasoningResource;

  /** Configuration for text generated by the agent. */
  text: TextResource;

  /** The effective service-tier policy for model requests. Defaults to `auto`. */
  service_tier: ServiceTierResource;

  /** Custom instructions appended to the agent's default base instructions. */
  instructions: string | null;

  /** Tools available to the agent. */
  @maxItems(2000)
  tools: AgentToolResource[];

  /** Configuration for creating and coordinating subagents. */
  multi_agent: MultiAgentConfigResource;
}

/** A Managed Agents session. */
model SessionResource {
  /** Custom string key-value pairs attached to the session. */
  metadata: Record<string>;

  /** The ID of the session. */
  id: string;

  /** The object type. Always `agent.session`. */
  object: SessionObject;

  /** The Unix timestamp, in seconds, when the session was created. */
  created_at: int64;

  /** The Unix timestamp, in seconds, when the session was last active. */
  last_active_at: int64;

  /** The current status of the session. */
  status: SessionStatusResource;

  /** Actions that must be completed before the session can continue. */
  @maxItems(2000)
  required_actions: SessionRequiredActionResource[];

  /** The error that caused the session to fail, if any. */
  error: string | null;

  /** The agent running in the session. */
  agent: SessionAgentResource;

  /** The execution environment for the session. */
  environment: EnvironmentResource;

  /** The IDs of vaults made available to the session. */
  @maxItems(2000)
  vault_ids: string[];

  /** Best-effort token usage for the session, or null if unknown. */
  usage: TokenUsageResource | null;
}

/** Agent configuration for a session. Omitted fields inherit from `agent_id` when supplied. */
model SessionAgentConfigParam {
  /** The model to use for the agent. The requested model name is preserved. */
  `model`?: string;

  /** Configuration for model reasoning. Omit to keep current settings; pass `null` to reset. */
  reasoning?: ReasoningParam | null;

  /** Configuration for text generated by the agent. */
  text?: TextParam | null;

  /** The service tier used for model requests. */
  service_tier?: ServiceTierParam | null;

  /** Additional instructions appended to the agent's default base instructions. */
  instructions?: string | null;

  /** Configuration for creating and coordinating subagents. */
  multi_agent?: MultiAgentConfigCurrentParam | null;

  /** Tools available to the agent. Omit to inherit, or pass null to clear them. */
  @maxItems(16384)
  tools?: AgentToolConfigParam[] | null;
}

/** Parameters for creating a Managed Agents session. */
model CreateAgentSessionParams {
  /** Up to 16 string key-value pairs. Omission or null defaults to an empty map. */
  metadata?: Record<string> | null;

  /** Agent configuration. With `agent_id`, supplied fields override the saved agent. */
  agent?: SessionAgentConfigParam;

  /** The ID of a saved reusable agent. Omit `agent` to use its configuration unchanged. */
  @maxLength(64)
  agent_id?: string;

  /** An inline execution environment or a reference to an environment template. */
  environment: EnvironmentParam;

  /** The IDs of vaults made available to the session. */
  @maxItems(16384)
  vault_ids?: string[] | null;

  /** Initial input to submit when the session is created. A string is shorthand for a single user message. */
  input?: (string | InputMessageParam[]) | null;

  /** Whether to stream session events as server-sent events. Defaults to `false`. */
  stream?: boolean = false;
}

/** Fields to update on an existing session. */
model UpdateAgentSessionParams {
  /** Replaces all metadata. Omit to leave unchanged, or pass null or `{}` to clear it. */
  metadata?: Record<string> | null;
}

/** The object type. Always `agent.session.deleted`. */
union DeletedSessionObject {
  string,
  agent_session_deleted: "agent.session.deleted",
}

/** A Managed Agents session removed from the public API. */
model DeletedSessionResource {
  /** The ID of the deleted session. */
  id: string;

  /** The object type. Always `agent.session.deleted`. */
  object: DeletedSessionObject;

  /** Whether the session has been removed from the public API. Always `true`. */
  deleted: boolean;
}

/** The order in which paginated sessions are returned. */
union AgentSessionCollectionOrder {
  string,

  /** Returns sessions in ascending order. */
  asc: "asc",

  /** Returns sessions in descending order. */
  desc: "desc",
}

@access(Access.public)
@usage(Usage.input)
model AgentSessionCollectionOptions {
  /** The maximum number of sessions to return. */
  @query
  limit?: integer;

  /** The order in which sessions are returned. Defaults to `desc`. */
  @query
  order?: AgentSessionCollectionOrder = AgentSessionCollectionOrder.desc;

  /** Only return sessions whose root agent has this ID. Omit to return sessions for all agents. */
  @query
  agent_id?: string;

  /** Return sessions after this session ID in the selected order. */
  @query
  @continuationToken
  after?: string;
}

/** A page of Managed Agents sessions. */
model SessionListResource {
  /** The object type, which is always `list`. */
  object: "list";

  /** The sessions returned in this page, in the requested sort order. */
  @pageItems
  data: SessionResource[];

  /** The ID of the first session in `data`, or `null` if the page is empty. */
  first_id: string | null;

  /** The ID of the last session in `data`, or `null` if the page is empty. */
  @continuationToken
  last_id: string | null;

  /** Whether there are more sessions to retrieve after this page. */
  has_more: boolean;
}

// ------------ Session artifacts ------------

/** The object type. Always `agent.session.artifact`. */
union SessionArtifactObject {
  string,
  agent_session_artifact: "agent.session.artifact",
}

/** An immutable file published by a completed hosted session turn. */
model SessionArtifactResource {
  /** The immutable artifact ID. */
  id: string;

  /** The object type. Always `agent.session.artifact`. */
  object: SessionArtifactObject;

  /** The ID of the session that owns the artifact. */
  session_id: string;

  /** The ID of the environment that produced the artifact. */
  environment_id: string;

  /** The ID of the completed turn that published the artifact. */
  turn_id: string;

  /** The original absolute file path in the execution environment. */
  path: string;

  /** The immutable artifact size in bytes. */
  @minValue(0)
  size_bytes: int64;

  /** The Unix timestamp, in seconds, when the artifact was published. */
  created_at: int64;
}

/** The object type. Always `agent.session.artifact.deleted`. */
union DeletedSessionArtifactObject {
  string,
  agent_session_artifact_deleted: "agent.session.artifact.deleted",
}

/** Confirmation that an immutable session artifact was deleted. */
model DeletedSessionArtifactResource {
  /** The ID of the deleted session artifact. */
  id: string;

  /** The object type. Always `agent.session.artifact.deleted`. */
  object: DeletedSessionArtifactObject;

  /** Whether the session artifact was deleted. Always `true`. */
  deleted: boolean;
}

/** The order in which paginated session artifacts are returned. */
union AgentSessionArtifactCollectionOrder {
  string,

  /** Returns artifacts in ascending order. */
  asc: "asc",

  /** Returns artifacts in descending order. */
  desc: "desc",
}

@access(Access.public)
@usage(Usage.input)
model AgentSessionArtifactCollectionOptions {
  /** The ID of the session. */
  @path
  session_id: string;

  /** The maximum number of artifacts to return, between 1 and 100. */
  @query
  limit?: integer;

  /** The order in which artifacts are returned. Defaults to `desc`. */
  @query
  order?: AgentSessionArtifactCollectionOrder = AgentSessionArtifactCollectionOrder.desc;

  /** Only return artifacts produced by this environment. */
  @query
  environment_id?: string;

  /** Return artifacts after this artifact ID in the selected order. */
  @query
  @continuationToken
  after?: string;
}

/** A page of session artifacts. */
model SessionArtifactListResource {
  /** The object type, which is always `list`. */
  object: "list";

  /** The artifacts returned in this page, in the requested sort order. */
  @pageItems
  data: SessionArtifactResource[];

  /** The ID of the first artifact in `data`, or `null` if the page is empty. */
  first_id: string | null;

  /** The ID of the last artifact in `data`, or `null` if the page is empty. */
  @continuationToken
  last_id: string | null;

  /** Whether there are more artifacts to retrieve after this page. */
  has_more: boolean;
}

// ------------ Session turns ------------

/** The object type for a turn. Always `agent.session.turn`. */
union TurnObjectResource {
  string,
  agent_session_turn: "agent.session.turn",
}

/** The current status of a turn. */
union TurnStatusResource {
  /** The turn is waiting to start. */
  queued: "queued",

  /** The turn is in progress. */
  in_progress: "in_progress",

  /** The turn is waiting for external input. */
  waiting: "waiting",

  /** The turn completed successfully. */
  completed: "completed",

  /** The turn failed. */
  failed: "failed",

  /** The turn was cancelled. */
  cancelled: "cancelled",
}

/** Stable public categories for session request failures. */
union SessionTurnErrorCodeResource {
  string,
  context_length_exceeded: "context_length_exceeded",
  session_budget_exceeded: "session_budget_exceeded",
  usage_limit_exceeded: "usage_limit_exceeded",
  credit_balance_exhausted: "credit_balance_exhausted",
  rate_limit_exceeded: "rate_limit_exceeded",
  server_overloaded: "server_overloaded",
  cyber_policy: "cyber_policy",
  connection_failed: "connection_failed",
  server_error: "server_error",
  authentication_error: "authentication_error",
  invalid_request: "invalid_request",
  resource_not_found: "resource_not_found",
  sandbox_error: "sandbox_error",
  executor_version_incompatible: "executor_version_incompatible",
  active_turn_not_steerable: "active_turn_not_steerable",
  request_timeout: "request_timeout",
  internal_error: "internal_error",
}

/** A customer-safe error describing why a session request failed. */
model SessionTurnErrorResource {
  /** A stable, machine-readable failure category. */
  code: SessionTurnErrorCodeResource;

  /** A customer-safe explanation of the failure. */
  message: string;
}

/** The canonical public representation of a session turn. */
model TurnResource {
  /** The ID of the turn. */
  id: string;

  /** The object type. Always `agent.session.turn`. */
  object: TurnObjectResource;

  /** The ID of the session that owns the turn. */
  session_id: string;

  /** The ID of the agent that ran the turn. */
  agent_id: string;

  /** The ID of the subagent that ran the turn, if applicable. */
  subagent_id: string | null;

  /** The current status of the turn. */
  status: TurnStatusResource;

  /** The Unix timestamp, in seconds, used to order the turn by creation time. */
  created_at: int64;

  /** The Unix timestamp, in seconds, when the turn started. */
  started_at: int64 | null;

  /** The Unix timestamp, in seconds, when the turn reached a terminal state. */
  completed_at: int64 | null;

  /** A customer-safe error. Non-null only for a failed turn. */
  error: SessionTurnErrorResource | null;

  /** Best-effort token usage for the turn, or null if unknown. */
  usage: TokenUsageResource | null;
}

/** The order in which paginated session turns are returned. */
union AgentSessionTurnCollectionOrder {
  string,

  /** Returns turns in ascending order. */
  asc: "asc",

  /** Returns turns in descending order. */
  desc: "desc",
}

@access(Access.public)
@usage(Usage.input)
model AgentSessionTurnCollectionOptions {
  /** The ID of the session. */
  @path
  session_id: string;

  /** The maximum number of turns to return, between 1 and 100. */
  @query
  limit?: integer;

  /** The order in which turns are returned. Defaults to `desc`. */
  @query
  order?: AgentSessionTurnCollectionOrder = AgentSessionTurnCollectionOrder.desc;

  /** Return turns after this turn ID in the selected order. */
  @query
  @continuationToken
  after?: string;
}

/** A page of session turns. */
model SessionTurnListResource {
  /** The object type, which is always `list`. */
  object: "list";

  /** The turns returned in this page, in the requested sort order. */
  @pageItems
  data: TurnResource[];

  /** The ID of the first turn in `data`, or `null` if the page is empty. */
  first_id: string | null;

  /** The ID of the last turn in `data`, or `null` if the page is empty. */
  @continuationToken
  last_id: string | null;

  /** Whether there are more turns to retrieve after this page. */
  has_more: boolean;
}

// ------------ Session items ------------

/** The order in which paginated session items are returned. */
union AgentSessionItemCollectionOrder {
  string,

  /** Returns items in ascending order. */
  asc: "asc",

  /** Returns items in descending order. */
  desc: "desc",
}

@access(Access.public)
@usage(Usage.input)
model AgentSessionItemCollectionOptions {
  /** The ID of the session. */
  @path
  session_id: string;

  /** The maximum number of items to return, between 1 and 100. */
  @query
  limit?: integer;

  /** The order in which items are returned. Defaults to `desc`. */
  @query
  order?: AgentSessionItemCollectionOrder = AgentSessionItemCollectionOrder.desc;

  /** Return items after this item ID in the selected order. */
  @query
  @continuationToken
  after?: string;
}

/** A page of session turn items. */
model SessionItemListResource {
  /** The object type, which is always `list`. */
  object: "list";

  /** The items returned in this page, in the requested sort order. */
  @pageItems
  data: SessionTurnItemResource[];

  /** The ID of the first item in `data`, or `null` if the page is empty. */
  first_id: string | null;

  /** The ID of the last item in `data`, or `null` if the page is empty. */
  @continuationToken
  last_id: string | null;

  /** Whether there are more items to retrieve after this page. */
  has_more: boolean;
}

// ------------ Session subagents ------------

/** The object type for a subagent. Always `agent.session.subagent`. */
union SubagentObjectResource {
  string,
  agent_session_subagent: "agent.session.subagent",
}

/** The current status of a subagent. */
union SubagentStatusResource {
  /** The subagent remains available, including while idle between turns. */
  active: "active",

  /** The subagent is closed. */
  closed: "closed",
}

/** A subagent created within a session. */
model SubagentResource {
  /** The ID of the subagent. */
  id: string;

  /** The object type. Always `agent.session.subagent`. */
  object: SubagentObjectResource;

  /** The ID of the session that owns the subagent. */
  session_id: string;

  /** The runner-assigned nickname, or null when unavailable. */
  name: string | null;

  /** Initial task content, or null when unavailable. */
  @maxItems(2000)
  instructions: AgentContentResource[] | null;

  /** The ID of the agent that created this subagent. */
  parent_agent_id: string;

  /** The current status of the subagent. */
  status: SubagentStatusResource;

  /** The Unix timestamp, in seconds, when the subagent was first opened. */
  opened_at: int64;

  /** The Unix timestamp, in seconds, when the subagent was closed. Null while active. */
  closed_at: int64 | null;
}

/** The order in which paginated subagents and their items are returned. */
union AgentSessionSubagentCollectionOrder {
  string,

  /** Returns resources in ascending order. */
  asc: "asc",

  /** Returns resources in descending order. */
  desc: "desc",
}

@access(Access.public)
@usage(Usage.input)
model AgentSessionSubagentCollectionOptions {
  /** The ID of the session. */
  @path
  session_id: string;

  /** The maximum number of subagents to return, between 1 and 100. */
  @query
  limit?: integer;

  /** The order in which subagents are returned. Defaults to `desc`. */
  @query
  order?: AgentSessionSubagentCollectionOrder = AgentSessionSubagentCollectionOrder.desc;

  /** Return subagents after this subagent ID in the selected order. */
  @query
  @continuationToken
  after?: string;
}

/** A page of session subagents. */
model SubagentListResource {
  /** The object type, which is always `list`. */
  object: "list";

  /** The subagents returned in this page, in the requested sort order. */
  @pageItems
  data: SubagentResource[];

  /** The ID of the first subagent in `data`, or `null` if the page is empty. */
  first_id: string | null;

  /** The ID of the last subagent in `data`, or `null` if the page is empty. */
  @continuationToken
  last_id: string | null;

  /** Whether there are more subagents to retrieve after this page. */
  has_more: boolean;
}

@access(Access.public)
@usage(Usage.input)
model AgentSessionSubagentItemCollectionOptions {
  /** The ID of the session. */
  @path
  session_id: string;

  /** The ID of the subagent. */
  @path
  subagent_id: string;

  /** The maximum number of items to return, between 1 and 100. */
  @query
  limit?: integer;

  /** The order in which items are returned. Defaults to `desc`. */
  @query
  order?: AgentSessionSubagentCollectionOrder = AgentSessionSubagentCollectionOrder.desc;

  /** Return items after this item ID in the selected order. */
  @query
  @continuationToken
  after?: string;
}

@access(Access.public)
@usage(Usage.input)
model AgentSessionSubagentTurnCollectionOptions {
  /** The ID of the session. */
  @path
  session_id: string;

  /** The ID of the subagent. */
  @path
  subagent_id: string;

  /** The maximum number of turns to return, between 1 and 100. */
  @query
  limit?: integer;

  /** The order in which turns are returned. Defaults to `desc`. */
  @query
  order?: AgentSessionSubagentCollectionOrder = AgentSessionSubagentCollectionOrder.desc;

  /** Return turns after this turn ID in the selected order. */
  @query
  @continuationToken
  after?: string;
}

@access(Access.public)
@usage(Usage.input)
model AgentSessionSubagentTurnItemCollectionOptions {
  /** The ID of the session. */
  @path
  session_id: string;

  /** The ID of the subagent. */
  @path
  subagent_id: string;

  /** The ID of the turn. */
  @path
  turn_id: string;

  /** The maximum number of items to return, between 1 and 100. */
  @query
  limit?: integer;

  /** The order in which items are returned. Defaults to `desc`. */
  @query
  order?: AgentSessionSubagentCollectionOrder = AgentSessionSubagentCollectionOrder.desc;

  /** Return items after this item ID in the selected order. */
  @query
  @continuationToken
  after?: string;
}
